# Application
NODE_ENV=development
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
PROXY_PORT=8080
PORT=8080

# PostgreSQL
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=salushchat
DB_PASS=change-me
DB_NAME=salushchat
DB_POOL_MAX=20
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Authentication — generate unique, strong values for every environment
JWT_SECRET=change-me-with-a-long-random-secret
JWT_REFRESH_SECRET=change-me-with-another-long-random-secret

# Required only when running the default database seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-before-running-seeds

# Redis
REDIS_URI=redis://:change-me@localhost:6379
REDIS_OPT_LIMITER_MAX=1
REDIS_OPT_LIMITER_DURATION=3000

# Limits and runtime behavior
SOCKET_ADMIN=false
USER_LIMIT=10000
CONNECTIONS_LIMIT=100000
CLOSED_SEND_BY_ME=true

# Meta / WhatsApp Official
VERIFY_TOKEN=change-me
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
USE_WHATSAPP_OFICIAL=false
URL_API_OFICIAL=http://localhost:3001
TOKEN_API_OFICIAL=

# Optional integrations
TRANSCRIBE_URL=
STRIPE_PRIVATE=
STRIPE_OK_URL=http://localhost:3000/billing/success
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel
MP_ACCESS_TOKEN=
MP_NOTIFICATION_URL=
ASAAS_TOKEN=
GERENCIANET_SANDBOX=true
GERENCIANET_CLIENT_ID=
GERENCIANET_CLIENT_SECRET=
GERENCIANET_PIX_CERT=
GERENCIANET_PIX_KEY=
